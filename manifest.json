{
  "manifest_version": 3,
  "name": "清塘 · B站评论区过滤器",
  "short_name": "清塘",
  "version": "1.2.0",
  "description": "清塘：把 B站评论区这口塘清干净。过滤以 @ 开头的一级 AI 刷屏评论，以及命中所设关键词的评论。纯本地运行，不上传任何数据。",
  "permissions": ["storage"],
  "host_permissions": ["https://*.bilibili.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "清塘 · B站评论区过滤器",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["src/keywords.js", "src/filter.js", "src/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["src/keywords.js", "src/filter.js", "src/content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
